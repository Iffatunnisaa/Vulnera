<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Upload CSV | Vulnera</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="text-white flex" style="background-color:#0F1035;">

  <!-- Sidebar -->
  <aside class="fixed top-0 left-0 ...">
    <%- include('sidebar') %>
  </aside>
  
  <!-- Main Content -->
  <main class="ml-64 p-8 flex-1 p-8">
    <!-- Judul Halaman -->
    <h2 class="text-2xl font-bold text-yellow-400 mb-6">📝 Upload Dataset CSV</h2>
    
    <!-- Alur Proses ML -->
    <div style="background:#263159; padding:1.5rem; border-radius:15px; margin:0 auto 2rem auto; max-width:600px;">
      <h4 style="color:#FFD66B; margin-bottom:1rem;">📋 Alur Proses Upload:</h4>
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
        <div style="text-align:center; flex:1;">
          <div style="background:#7FC7D9; border-radius:50%; width:40px; height:40px; 
                      display:flex; align-items:center; justify-content:center; 
                      margin:0 auto 0.5rem auto; color:#263159; font-weight:bold;">1</div>
          <small style="color:#DCF2F1;">Upload CSV</small>
        </div>
        <div style="flex:1; height:2px; background:#7FC7D9; margin:0 1rem;"></div>
        <div style="text-align:center; flex:1;">
          <div style="background:#7FC7D9; border-radius:50%; width:40px; height:40px; 
                      display:flex; align-items:center; justify-content:center; 
                      margin:0 auto 0.5rem auto; color:#263159; font-weight:bold;">2</div>
          <small style="color:#DCF2F1;">ML Prediction</small>
        </div>
        <div style="flex:1; height:2px; background:#7FC7D9; margin:0 1rem;"></div>
        <div style="text-align:center; flex:1;">
          <div style="background:#7FC7D9; border-radius:50%; width:40px; height:40px; 
                      display:flex; align-items:center; justify-content:center; 
                      margin:0 auto 0.5rem auto; color:#263159; font-weight:bold;">3</div>
          <small style="color:#DCF2F1;">Save to DB</small>
        </div>
      </div>
      <p style="font-size:0.9rem; color:#DCF2F1; margin:0;">
        File akan diproses dengan AI untuk deteksi anomali sebelum disimpan ke database
      </p>
    </div>


    <!-- Form Upload -->
    <form action="/admin/upload" method="POST" enctype="multipart/form-data" 
      class="bg-[#263159] p-6 rounded-xl shadow-lg text-center">
      
      <!-- Drop Area -->
      <div id="drop-area" 
        class="border-2 border-dashed border-[#7FC7D9] p-8 rounded-lg bg-[#365486] mb-6 cursor-pointer transition"
        onmouseover="this.style.background='#4A6FA5'; this.style.borderColor='#DCF2F1';"
        onmouseout="this.style.background='#365486'; this.style.borderColor='#7FC7D9';"
        ondragover="handleDragOver(event)"
        ondrop="handleDrop(event)"
        ondragenter="handleDragEnter(event)"
        ondragleave="handleDragLeave(event)">
        
        <input id="file-input" type="file" name="csvFile" accept=".csv" class="hidden" onchange="showFileName()">
        
        <div>
          <div class="text-4xl mb-2">📁</div>
          <h4 class="text-yellow-400 mb-1">Drag & Drop file CSV di sini</h4>
          <p class="text-[#DCF2F1] mb-4">atau</p>
          <button type="button" onclick="document.getElementById('file-input').click()"
            class="bg-[#7FC7D9] text-[#263159] px-4 py-2 rounded-lg font-semibold hover:bg-[#DCF2F1] transition">
            📂 Pilih File CSV
          </button>
        </div>
      </div>
      
      <!-- File Info -->
      <div id="file-info" class="hidden bg-[#4A6FA5] p-4 rounded-lg mb-6 flex justify-between items-center">
        <div>
          <p id="file-name" class="text-yellow-400 font-semibold"></p>
          <p id="file-size" class="text-sm text-[#DCF2F1]"></p>
        </div>
        <button type="button" onclick="removeFile()" 
          class="bg-red-500 px-2 py-1 rounded-full text-white text-lg">×</button>
      </div>

      <!-- Upload Button -->
      <button type="submit" id="upload-btn" disabled
        class="bg-gradient-to-r from-yellow-300 to-yellow-200 text-[#263159] px-6 py-2 rounded-full font-semibold transition opacity-50">
        🚀 Upload & Proses dengan ML
      </button>

      <!-- Progress -->
      <div id="upload-progress" class="hidden mt-4">
        <div class="bg-[#365486] rounded-lg p-1 mb-2">
          <div id="progress-bar" class="bg-gradient-to-r from-[#7FC7D9] to-[#DCF2F1] h-2 rounded-lg w-0 transition-all"></div>
        </div>
        <p id="progress-text" class="text-sm text-[#DCF2F1]">Menyiapkan upload...</p>
      </div>
    </form>

    <!-- Pesan Flash -->
    <% if (success_msg && success_msg.length > 0) { %>
      <div class="bg-gradient-to-r from-green-500 to-green-600 text-white p-4 mt-6 rounded-lg shadow-md flex items-center">
        <span class="text-xl mr-2">✅</span>
        <span><%= success_msg %></span>
      </div>
    <% } %>

    <% if (error_msg && error_msg.length > 0) { %>
      <div class="bg-gradient-to-r from-red-500 to-red-600 text-white p-4 mt-6 rounded-lg shadow-md flex items-center">
        <span class="text-xl mr-2">❌</span>
        <span><%= error_msg %></span>
      </div>
    <% } %>
  </main>

  <!-- Script sama dengan sebelumnya -->
  <script>
    // File handling functions
    function showFileName() {
      const fileInput = document.getElementById("file-input");
      const fileInfo = document.getElementById("file-info");
      const fileName = document.getElementById("file-name");
      const fileSize = document.getElementById("file-size");
      const uploadBtn = document.getElementById("upload-btn");
      
      if (fileInput.files.length > 0) {
        const file = fileInput.files[0];
        fileName.textContent = "📄 " + file.name;
        fileSize.textContent = "📏 Ukuran: " + formatFileSize(file.size);
        fileInfo.style.display = "block";
        uploadBtn.disabled = false;
        uploadBtn.style.opacity = "1";
      }
    }

    function removeFile() {
      const fileInput = document.getElementById("file-input");
      const fileInfo = document.getElementById("file-info");
      const uploadBtn = document.getElementById("upload-btn");
      
      fileInput.value = "";
      fileInfo.style.display = "none";
      uploadBtn.disabled = true;
      uploadBtn.style.opacity = "0.5";
    }

    function formatFileSize(bytes) {
      if (bytes === 0) return '0 Bytes';
      const k = 1024;
      const sizes = ['Bytes', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }

    // Drag and drop functions
    function handleDragOver(event) {
      event.preventDefault();
      event.currentTarget.style.background = '#4A6FA5';
      event.currentTarget.style.borderColor = '#DCF2F1';
    }

    function handleDragEnter(event) {
      event.preventDefault();
      event.currentTarget.style.background = '#4A6FA5';
      event.currentTarget.style.borderColor = '#DCF2F1';
    }

    function handleDragLeave(event) {
      event.preventDefault();
      event.currentTarget.style.background = '#365486';
      event.currentTarget.style.borderColor = '#7FC7D9';
    }

    function handleDrop(event) {
      event.preventDefault();
      event.currentTarget.style.background = '#365486';
      event.currentTarget.style.borderColor = '#7FC7D9';
      
      const files = event.dataTransfer.files;
      if (files.length > 0) {
        const file = files[0];
        if (file.type === 'text/csv' || file.name.endsWith('.csv')) {
          const fileInput = document.getElementById("file-input");
          fileInput.files = files;
          showFileName();
        } else {
          alert('Hanya file CSV yang diizinkan!');
        }
      }
    }

    // Form submission with progress
    document.querySelector('form').addEventListener('submit', function(e) {
      const uploadBtn = document.getElementById("upload-btn");
      const progressDiv = document.getElementById("upload-progress");
      const progressBar = document.getElementById("progress-bar");
      const progressText = document.getElementById("progress-text");
      
      // Show progress
      uploadBtn.disabled = true;
      uploadBtn.textContent = "⏳ Memproses...";
      progressDiv.style.display = "block";
      
      // Simulate progress
      let progress = 0;
      const interval = setInterval(() => {
        progress += Math.random() * 15;
        if (progress > 90) progress = 90;
        
        progressBar.style.width = progress + '%';
        
        if (progress < 30) {
          progressText.textContent = "📤 Mengupload file...";
        } else if (progress < 60) {
          progressText.textContent = "🤖 Memproses dengan ML...";
        } else if (progress < 90) {
          progressText.textContent = "💾 Menyimpan ke database...";
        }
        
        if (progress >= 90) {
          clearInterval(interval);
        }
      }, 500);
    });
  </script>
</body>
</html>